NODE_ENV=development
PORT=5000

# New Relic APM monitoring (optional). Provide a valid license key to enable.
# Read from NEW_RELIC_LICENSE_KEY at runtime; never hardcode this value.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=EdTech Backend

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edtech
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=YourJWTSecretHere

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google_oauth2/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Real inbox delivery requires EMAIL_USER and an SMTP app password in EMAIL_PASS.
# Without these, development sends to an Ethereal test inbox; it does not reach the recipient's inbox.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Frontend URL
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Live classes. LiveKit Cloud is recommended for production conferencing.
# Leave these blank only for local Socket.IO/WebRTC development; configure TURN there.
# The backend must run as an always-on Socket.IO/worker process for real-time
# notifications and reminders. Serverless deployments cannot host classrooms.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_CLASS_ATTENDANCE_THRESHOLD=50

# Custom Multi-Level Referral & Reward System (No 3rd Party/Branch Dependency)
ENABLE_REFERRAL_SYSTEM=true
ENABLE_MULTI_LEVEL_REWARDS=false
REFERRAL_BASE_URL=http://localhost:3000/register
REFERRAL_CODE_LENGTH=10
REFERRAL_REGISTRATION_REWARD=20
REFERRAL_LEVEL_1_PERCENT=10
REFERRAL_LEVEL_2_PERCENT=5
REFERRAL_LEVEL_3_PERCENT=2
REFERRAL_LEVEL_4_PERCENT=1
REFERRAL_MAX_LEVELS=4
